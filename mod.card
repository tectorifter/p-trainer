return {
  summary = "Gen 3 (Emerald) summary-screen editor: IVs, EVs, nature and ability slot in place behind SELECT, plus TUTOR/EGG MOVE teaching via the party menu, item reuse, Exp. Share, forced doubles, rematches, level adapt and difficulty.",
  author = "tectorifter",
  tags = { "gen3", "emerald", "trainer", "summary", "ev" },
  differences = {
    added = {
      "The native summary screen edits IVs/EVs in place behind SELECT: an EV/IV/APPLY/CANCEL menu, two-column stat grids with a CONFIRM row, and the profile page edits nature and ability slot (IV 200/pt, EV 125/pt, nature 2000, ability 5000) with a cost confirm.",
      "TUTOR and EGG MOVE rows in the field party menu open locked move lists (5000 a teach); the egg list covers the mon's whole evolution line and re-teaching a known move is refused free.",
      "A 1512 EVS option: OFF, NPC (enemy trainer mons may hold 1512 total EVs), PLAYER (your mons may), BOTH.",
      "ITEM REUSE: held items consumed or lost in battle return afterwards. EXP SHARE: off / gen1 / gen2 / gen3 / gen6 party splits on Gen 3's own exp seam.",
      "DAMAGE SPLIT applies the gen 4 physical/special move split (off by default).",
      "DOUBLES forces 2+ mon trainers into native double battles. REMATCHES asks beaten trainers for a paid rematch. LV ADAPT (-5/+5/+10/0) and DIFFICULTY (easy/normal/hard/very hard/hell) retune trainer teams.",
      "ENEMY EVO evolves trainer mons whose level allows it (off by default).",
      "GYM TEAMS fills gym leader and Elite Four teams to 6 with random specialty-type mons (off by default), moving each team's ace to the last slot so it is fought last; added slots field the evolution stage the team's top level allows, following poke-ecology's GEN 1..9 toggles when that mod is present.",    },
    known = {
      "an unofficial fan mod: Pokemon and all related names and assets are (c) Nintendo / Creatures Inc. / GAME FREAK inc. / The Pokemon Company and this project is not affiliated with or endorsed by them",
    },
  },
  compat = { engine = ">=0.0.0-0 <2.0.0", modApi = 2 },
}
